---
import { Image } from "astro:assets";

export interface Props {
  title: string;
  posts: Array<{ slug: string; title: string; excerpt: string; image: any; date: string; category?: string; author?: string; readTime?: string }>;
  compact?: boolean;
  bgClass?: string;
}

const { title, posts, compact = false, bgClass = "bg-[#faf8fc]" } = Astro.props;
---

<section class={bgClass}>
  <div class="container section-space">
    <div class={`mb-10 md:mb-14 ${compact ? "flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between sm:gap-8" : "text-center"}`}>
      <h2 class={`section-title ${compact ? "" : "max-w-[900px] mx-auto"}`} data-animate="fade-up">{title}</h2>
      {compact && <a href="/blog/" class="primary-button shrink-0 self-start sm:self-auto" data-animate="fade-up" style="--delay: 0.15s">View All<span class="button-circle"><svg width="18" height="18" viewBox="0 0 30 30" fill="none"><path d="M7.854 15h14.292" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" /><path d="m16.34 9.194 5.806 5.806-5.806 5.806" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg></span></a>}
    </div>
    <div class="grid gap-8 lg:grid-cols-2">
      {posts.map((post, i) => (
        <article data-animate="fade-up" style={`--delay: ${i * 0.15}s`}>
          {/* Image with date badge */}
          <a href={`/blog/${post.slug}/`} class="group relative block overflow-hidden">
            <Image
              src={post.image}
              alt={post.title}
              class="h-auto w-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-0 right-0 flex flex-col items-center justify-center bg-primary px-4 py-3 text-white min-w-[64px]">
              <span class="text-[22px] font-semibold leading-none">{post.date.split(" ")[0]}</span>
              <span class="text-[15px] mt-0.5">{post.date.split(" ")[1]}</span>
            </div>
          </a>
          {/* Content */}
          <div class="pt-6">
            <h3 class="text-[20px] md:text-[26px] font-semibold leading-[1.25]">
              <a href={`/blog/${post.slug}/`} class="hover:text-primary transition-colors">{post.title}</a>
            </h3>
            <p class="mt-3 text-[18px] leading-[1.6] text-body">{post.excerpt}</p>
            <a
              href={`/blog/${post.slug}/`}
              class="mt-6 inline-flex items-center gap-3 text-[17px] font-medium text-heading hover:text-primary transition-colors"
            >
              Read Details
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary text-white">
                <svg width="14" height="14" viewBox="0 0 30 30" fill="none">
                  <path d="M7.842 22.158L22.158 7.842" stroke="currentColor" stroke-width="2.38" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M10.526 7.842h11.632v11.632" stroke="currentColor" stroke-width="2.38" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

---
export interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;
---

<div class="h-[420px] w-full md:h-[500px]" data-animate="fade-blur">
  <iframe
    src={src}
    width="100%"
    height="100%"
    style="border:0;"
    allowfullscreen
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    title={title}
  ></iframe>
</div>

---
import { Image } from "astro:assets";
import { footerMenus, logo } from "@/data/site";
---

<footer class="border-t border-border bg-surface">
  <div class="container section-space-sm">
    <div class="grid gap-10 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-[1fr_1fr_1fr_1.3fr] lg:gap-12">
      <div>
        <h2 class="mb-4 text-[20px] font-semibold leading-none lg:text-[28px]">Menu</h2>
        <ul class="space-y-2.5 text-[16px] lg:text-[18px]">
          {footerMenus.menu.map((item) => (
            <li><a href={item.href} class="hover:text-primary">{item.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="mb-4 text-[20px] font-semibold leading-none lg:text-[28px]">Utility Pages</h2>
        <ul class="space-y-2.5 text-[16px] lg:text-[18px]">
          {footerMenus.utility.map((item) => (
            <li><a href={item.href} class="hover:text-primary">{item.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="mb-4 text-[20px] font-semibold leading-none lg:text-[28px]">Social Media</h2>
        <ul class="space-y-2.5 text-[16px] lg:text-[18px]">
          {footerMenus.social.map((item) => (
            <li><a href={item.href} class="hover:text-primary">{item.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="sm:col-span-2 md:col-span-3 lg:col-span-1">
        <h2 class="mb-4 text-[20px] font-semibold leading-[1.2] lg:text-[28px]">Subscribe to Our Newsletter!</h2>
        <p class="text-[16px] lg:text-[18px]">Stay informed with our latest security insights subscribe to our newsletter!</p>
        <form class="mt-5 flex max-w-full items-center rounded-full border border-border bg-white p-1.5">
          <label class="sr-only" for="footer-email">Email</label>
          <input id="footer-email" class="min-w-0 flex-1 bg-transparent px-2 py-2.5 text-[16px] outline-none sm:px-4" type="email" placeholder="Entry your Email" />
          <button class="shrink-0 rounded-full bg-primary px-3 py-2.5 text-[14px] font-semibold text-white sm:px-5 sm:text-[15px]" type="button">Subscribe</button>
        </form>
      </div>
    </div>
    <div class="mt-16 border-t border-border pt-10">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <Image src={logo.dark} alt="Influvo logo" class="h-auto w-[170px]" loading="lazy" decoding="async" />
        <p class="text-[18px]">Copyright © Influvo | Designed by <a href="#" target="_blank" rel="noopener noreferrer" class="hover:text-primary transition-colors">HasThemes</a></p>
      </div>
    </div>
  </div>
</footer>

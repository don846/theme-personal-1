---
import { Image } from "astro:assets";
import Button from "@/components/Button.astro";

export interface Props {
  title: string;
  highlight: string;
  bgImage: ImageMetadata;
  shapeImage: ImageMetadata;
  metrics: Array<{ title: string; value: string; color: string }>;
  cta: { title: string; buttonLabel: string; buttonHref: string; linkLabel: string; linkHref: string };
}

const { title, highlight, bgImage, shapeImage, metrics, cta } = Astro.props;
const [beforeHighlight, afterHighlight] = title.split(highlight);
---

<section class="relative pb-[180px] pt-[100px]">
  <Image src={bgImage} alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
  <div class="container relative">
    {/* Title row: heading (70%) + decorative shape (30%) */}
    <div class="mb-10 flex items-start justify-between md:mb-[60px]">
      <h2 class="section-title w-full text-white md:w-[70%]" data-animate="fade-up">
        {beforeHighlight}<span class="text-secondary">{highlight}</span>{afterHighlight}
      </h2>
      <div class="hidden md:flex md:w-[30%] items-end justify-center" data-animate="fade-up" style="--delay: 0.15s">
        <Image src={shapeImage} alt="" aria-hidden="true" class="w-full max-w-[200px]" loading="lazy" decoding="async" />
      </div>
    </div>

    {/* 4-column metric cards */}
    <div class="grid gap-[25px] md:grid-cols-2 xl:grid-cols-4">
      {metrics.map((item, i) => (
        <div class={`${item.color} flex h-[275px] flex-col justify-between rounded-[12px] p-5 text-heading`} data-animate="scale-y" style={`--delay: ${i * 0.1}s`}>
          <h3 class="text-[28px] font-medium leading-[1.3]">{item.title}</h3>
          <p class="ml-auto text-[40px] font-semibold leading-[1.3]">{item.value}</p>
        </div>
      ))}
    </div>

    {/* CTA card */}
    <div class="mt-14 rounded-[20px] bg-white p-8 text-heading shadow-soft md:p-10" data-animate="fade-up">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
        <h3 class="max-w-[760px] text-[28px] font-semibold leading-[1.2] md:text-[42px] lg:text-[50px]">
          {cta.title}
        </h3>
        <div class="flex shrink-0 flex-col gap-4">
          <Button href={cta.buttonHref} label={cta.buttonLabel} />
          <a href={cta.linkHref} class="text-[18px] font-medium hover:text-primary">{cta.linkLabel}</a>
        </div>
      </div>
    </div>
  </div>
</section>

---
export interface Props {
  eyebrow: string;
  title: string;
  items: Array<{ title: string; text: string }>;
}

const { eyebrow, title, items } = Astro.props;
---

<section class="bg-white">
  <div class="container section-space">
    <div class="grid gap-12 xl:grid-cols-[0.2fr_1fr]">
      <p class="eyebrow pt-3" data-animate="fade-up">{eyebrow}</p>
      <div>
        <h2 class="section-title max-w-[780px]" data-animate="fade-up" style="--delay: 0.1s">{title}</h2>
        <div class="mt-14 space-y-0">
          {items.map((item, i) => (
            <article class="border-b border-border py-8 first:pt-0" data-animate="fade-up" style={`--delay: ${0.1 + i * 0.1}s`}>
              <div class="flex items-start gap-5">
                <span class="mt-3 inline-block h-[25px] w-[25px] shrink-0 rounded-full border-[5px] border-[#e5daf2] bg-primary md:h-[30px] md:w-[30px] md:border-[6px] xl:h-[35px] xl:w-[35px] xl:border-[9px]"></span>
                <div>
                  <h3 class="text-[24px] md:text-[38px] font-semibold">{item.title}</h3>
                  <p class="mt-4 max-w-[1100px] text-[17px] md:text-[22px] leading-[1.65]">{item.text}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

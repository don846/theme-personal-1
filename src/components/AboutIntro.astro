---
import { Image } from "astro:assets";

export interface Props {
  eyebrow: string;
  title: string;
  highlight: string;
  avatars: ImageMetadata[];
  statValue: string;
  statLabel: string;
  paragraphs: string[];
  videoImage: ImageMetadata;
  videoId: string;
}

const { eyebrow, title, highlight, avatars, statValue, statLabel, paragraphs, videoImage, videoId } = Astro.props;
const [beforeHighlight, afterHighlight] = title.split(highlight);
---

<section class="bg-surface">
  <div class="container section-space">
    <div class="grid gap-12 xl:grid-cols-[0.2fr_1fr]">
      <p class="eyebrow pt-3" data-animate="fade-up">{eyebrow}</p>
      <div>
        <h2 class="section-title max-w-[980px]" data-animate="fade-up" style="--delay: 0.1s">
          {beforeHighlight}<span class="text-secondary">{highlight}</span>{afterHighlight}
        </h2>
        <div class="mt-12 grid gap-10 lg:grid-cols-[0.28fr_1fr]">
          <div class="lg:border-r border-border lg:pr-8" data-animate="fade-up" style="--delay: 0.15s">
            {/* Overlapping avatars */}
            <div class="mb-5 flex items-center">
              {avatars.map((avatar, i) => (
                <Image
                  src={avatar}
                  alt="Trusted company"
                  class:list={[
                    "relative h-12 w-12 rounded-full object-cover ring-2 ring-white",
                    i < avatars.length - 1 ? "-mr-3" : ""
                  ]}
                  style={`z-index: ${avatars.length - i}`}
                />
              ))}
            </div>
            <p class="text-[36px] md:text-[58px] font-medium leading-none">{statValue}</p>
            <p class="mt-2 text-[18px] md:text-[22px] leading-[1.35]">{statLabel}</p>
          </div>
          <div class="space-y-8 text-[18px] md:text-[22px] leading-[1.65]" data-animate="fade-up" style="--delay: 0.2s">
            {paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>
        <div class="relative mt-14" data-animate="fade-blur" style="--delay: 0.1s">
          <Image src={videoImage} alt="About video cover" class="h-auto w-full object-cover" />
          {/* Play button overlay */}
          <button
            id="video-play-btn"
            aria-label="Play video"
            class="absolute left-1/2 top-1/2 flex h-20 w-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white shadow-lg transition-transform hover:scale-110"
          >
            <svg class="ml-1" width="24" height="28" viewBox="0 0 24 28" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M2 2L22 14L2 26V2Z" fill="#7D30E2" stroke="#7D30E2" stroke-width="2" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>

        {/* Video modal */}
        <div id="video-modal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/80 p-4">
          <div class="relative w-full max-w-4xl">
            <button
              id="video-close-btn"
              aria-label="Close video"
              class="absolute -top-10 right-0 text-white hover:text-white/70 transition-colors"
            >
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
            <div class="aspect-video w-full">
              <div id="about-video-container" class="h-full w-full"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ videoId }}>
  const modal = document.getElementById("video-modal");
  const container = document.getElementById("about-video-container");

  function openModal() {
    // Inject iframe only on user interaction (facade pattern)
    const iframe = document.createElement("iframe");
    iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
    iframe.title = "Influvo about video";
    iframe.allow = "autoplay; encrypted-media; picture-in-picture";
    iframe.allowFullscreen = true;
    iframe.className = "h-full w-full border-0";
    iframe.style.cssText = "width:100%;height:100%;";
    container.appendChild(iframe);

    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    // Destroy iframe to stop playback and free network resources
    container.innerHTML = "";
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    document.body.style.overflow = "";
  }

  document.getElementById("video-play-btn").addEventListener("click", openModal);
  document.getElementById("video-close-btn").addEventListener("click", closeModal);
  modal.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModal();
  });
</script>

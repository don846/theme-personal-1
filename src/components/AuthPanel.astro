---
import { Image } from "astro:assets";
import logo from "@/assets/images/Frame-2147223321.png";

export interface Props {
  title: string;
  subtitle: string;
  image: ImageMetadata;
  imageAlt: string;
}

const { title, subtitle, image, imageAlt } = Astro.props;
---

<main class="flex h-screen w-full gap-6 p-6">

  {/* Left — form panel */}
  <div class="flex w-full flex-col items-center justify-center rounded bg-[#f7f5fa] px-10 py-10 lg:w-1/2">
    <div class="w-full max-w-[420px]">

      {/* Logo */}
      <a href="/" class="mx-auto mb-8 block w-[185px]">
        <Image src={logo} alt="Influvo" class="h-auto w-full" />
      </a>

      {/* Heading */}
      <div class="mb-8 text-center">
        <h1 class="text-[32px] font-semibold leading-[1.2] text-heading">{title}</h1>
        <p class="mt-2 text-[18px] text-body">{subtitle}</p>
      </div>

      <slot />
    </div>
  </div>

  {/* Right — image panel */}
  <div class="hidden overflow-hidden rounded lg:block lg:w-1/2">
    <Image
      src={image}
      alt={imageAlt}
      class="h-full w-full object-cover"
    />
  </div>

</main>

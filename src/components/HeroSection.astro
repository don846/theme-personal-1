---
import { Image } from "astro:assets";
import Button from "@/components/Button.astro";
import { sharedStats } from "@/data/content";
import { siteMeta } from "@/data/site";
import heroBg from "@/assets/images/Hero-Banner-1.jpg";
import shape1 from "@/assets/images/Home-One-Hero-Shape-1.png";
import shape2 from "@/assets/images/Home-One-Hero-Shape-2.png";

export interface Props {
  title: string;
  highlight: string;
  description: string;
  image: any;
  theme?: "light" | "dark";
  /** Webflow Home One: centered headline + promo block in the right column with the hero image. */
  layout?: "default" | "centered";
  /** YouTube video ID for the play button modal. Defaults to the shared site video. */
  videoId?: string;
  /** Start time in seconds for the play button video. */
  videoStart?: number;
}

const { title, highlight, description, image, theme = "light", layout = "default", videoId = siteMeta.videoId, videoStart = 0 } = Astro.props;
const dark = theme === "dark";
const centered = layout === "centered";
const [beforeHighlight, afterHighlight] = title.split(highlight);
---

<section
  class:list={[
    "relative overflow-hidden",
    dark ? "bg-hero text-white" : "bg-hero-light",
    dark ? "pt-0" : ""
  ]}
>
  {dark && (
    <Image
      src={heroBg}
      alt=""
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover object-center pointer-events-none select-none"
    />
  )}
  {!dark && <div class="absolute inset-0 muted-grid opacity-70"></div>}
  <div
    class:list={[
      "container relative",
      dark ? "pb-0 pt-[100px] md:pt-[200px] md:pb-0 xl:pt-[240px]" : "pb-0 pt-12 md:pt-20 xl:pt-24"
    ]}
  >
    {
      centered ? (
        <>
          <div class="px-2 md:px-4" data-animate="fade-up">
            <h1 class:list={["display-title text-balance text-center md:text-left md:text-[44px] tablet:text-[60px] xl:text-[90px]", dark ? "text-white" : ""]}>
              {beforeHighlight}
              <span class="text-secondary">{highlight}</span>
              {afterHighlight}
            </h1>
          </div>

          {/* Mobile only: stacked layout (< 768px) */}
          <div class="mt-10 flex flex-col items-center gap-10 md:hidden">
            {/* Promote block */}
            <div class:list={["flex w-full flex-col items-center text-center", dark ? "text-white" : ""]} data-animate="fade-up">
              <div class="mb-4 flex items-center gap-4">
                <button
                  id="hero-video-btn-mobile"
                  aria-label="Play video"
                  class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-lime text-heading"
                >
                  <svg width="17" height="22" viewBox="0 0 17 22" fill="none">
                    <path d="M15.965 9.728c.94.588.94 1.956 0 2.544L2.295 20.816C1.296 21.44 0 20.722 0 19.544V2.456C0 1.278 1.296.56 2.295 1.184l13.67 8.544Z" fill="currentColor" />
                  </svg>
                </button>
                <h2 class:list={["text-[24px] font-semibold", dark ? "text-white" : ""]}>Promote Your Product</h2>
              </div>
              <p class:list={["max-w-[300px] text-[18px] leading-[1.6]", dark ? "text-white/75" : "text-body"]}>{description}</p>
              <div class="mt-6">
                <Button href="/contact/" label="Let's Talk" />
              </div>
            </div>

            {/* Circle stat */}
            <div
              class:list={[
                "h-[200px] w-[200px] rounded-full border p-2.5 text-center",
                dark ? "border-white/30 bg-white/[0.08]" : "border-border bg-white/70"
              ]}
              data-animate="fade-up"
              style="--delay: 0.1s"
            >
              <div
                class:list={[
                  "flex h-full w-full flex-col items-center justify-center rounded-full border",
                  dark ? "border-[#b8b4b4]/40 [background:linear-gradient(146deg,rgba(255,255,255,0.5),rgba(0,0,0,0.85))]" : "bg-white/80"
                ]}
              >
                <span class:list={["text-[40px] font-medium leading-none", dark ? "text-white" : ""]}>{sharedStats.influencers}</span>
                <span class:list={["mt-2 text-[18px] leading-[1.3]", dark ? "text-white" : ""]}>Popular Influencer</span>
              </div>
            </div>

            {/* Hero image */}
            <Image src={image} alt="Influencer hero image" loading="eager" fetchpriority="high" class="h-auto w-full" data-animate="fade-up" style="--delay: 0.15s" />
          </div>

          {/* Tablet layout (768px - 1279px) */}
          <div class="hero-tablet relative mt-6 pb-[80px]">
            <div class:list={["flex items-start justify-between gap-6", dark ? "text-white" : ""]}>
              {/* Left: promo block */}
              <div class="relative z-[2] flex max-w-[340px] flex-col items-start gap-4" data-animate="fade-up">
                <div class="flex items-center gap-4">
                  <button
                    id="hero-video-btn-tablet"
                    aria-label="Play video"
                    class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-lime text-heading"
                  >
                    <svg width="17" height="22" viewBox="0 0 17 22" fill="none">
                      <path d="M15.965 9.728c.94.588.94 1.956 0 2.544L2.295 20.816C1.296 21.44 0 20.722 0 19.544V2.456C0 1.278 1.296.56 2.295 1.184l13.67 8.544Z" fill="currentColor" />
                    </svg>
                  </button>
                  <h2 class:list={["text-[22px] font-semibold", dark ? "text-white" : ""]}>Promote Your Product</h2>
                </div>
                <p class:list={["text-[18px] leading-[1.6]", dark ? "text-white/75" : "text-body"]}>{description}</p>
                <Button href="/contact/" label="Let's Talk" />
              </div>

              {/* Right: stat circle */}
              <div
                class:list={[
                  "relative z-[2] h-[170px] w-[170px] shrink-0 rounded-full border p-2.5 text-center",
                  dark ? "border-white/[0.3] bg-white/[0.08]" : "border-border bg-white/70"
                ]}
                data-animate="fade-up"
                style="--delay: 0.1s"
              >
                <div
                  class:list={[
                    "flex h-full w-full flex-col items-center justify-center rounded-full border",
                    dark ? "border-[#b8b4b4]/60 [background:linear-gradient(146deg,rgba(255,255,255,0.5),rgba(0,0,0,0.85))]" : "bg-white/80"
                  ]}
                >
                  <span class:list={["text-[36px] font-medium leading-none", dark ? "text-white" : ""]}>{sharedStats.influencers}</span>
                  <span class:list={["mt-1 text-[14px] leading-[1.3]", dark ? "text-white" : ""]}>Popular Influencer</span>
                </div>
              </div>
            </div>

            {/* Bottom stats: customer card + satisfaction side by side */}
            <div class:list={["relative z-[2] mt-8 flex flex-row items-start gap-8", dark ? "text-white" : ""]} data-animate="fade-up" style="--delay: 0.15s">
              <div
                class:list={[
                  "w-[200px] rounded-[12px] border p-2",
                  dark ? "border-white/[0.3] bg-white/[0.08]" : "card-shell bg-white/80"
                ]}
              >
                <div
                  class:list={[
                    "rounded-[8px] border-2 px-[12px] py-4",
                    dark ? "border-[#b8b4b4]/60 [background:linear-gradient(137deg,rgba(255,255,255,0.1),rgba(0,0,0,0.8))]" : "border-border bg-white"
                  ]}
                >
                  <div class="mb-3 flex -space-x-3">
                    {sharedStats.avatars.map((avatar) => (
                      <Image src={avatar} alt="Customer avatar" class="h-[44px] w-[44px] rounded-full border-2 border-white object-cover" />
                    ))}
                  </div>
                  <p class:list={["text-[18px] font-medium", dark ? "text-white" : ""]}>We Have</p>
                  <p class="text-[18px] font-semibold text-secondary">{sharedStats.customers}</p>
                  <p class:list={["text-[18px] font-medium", dark ? "text-white" : ""]}>World-wide</p>
                </div>
              </div>

              <div class="mt-2">
                <div class="flex items-center gap-3">
                  <span class="flex h-[44px] w-[44px] shrink-0 items-center justify-center rounded-full bg-lime text-heading">
                    <svg width="24" height="25" viewBox="0 0 30 31" fill="none">
                      <path d="M7.632 22.868L22.368 8.132" stroke="currentColor" stroke-width="2.456" stroke-linecap="round" stroke-linejoin="round" />
                      <path d="M10.395 8.132H22.368V20.105" stroke="currentColor" stroke-width="2.456" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                  <span class:list={["text-[50px] font-semibold leading-none", dark ? "text-white" : ""]}>{sharedStats.satisfaction}</span>
                </div>
                <p class:list={["mt-2 text-[20px]", dark ? "text-white" : ""]}>Satisfied Services</p>
              </div>
            </div>

            {/* Person image - rises up from mid-section, clipped at bottom by section overflow-hidden */}
            <Image
              src={image}
              alt="Influencer hero image"
              loading="eager"
              fetchpriority="high"
              data-animate="fade"
              style="--delay: 0.1s"
              class="absolute top-auto right-0 bottom-0 w-[320px]"
            />
          </div>

          {/* Desktop: webflow-matching flex layout with absolute person image */}
          <div class="hero-desktop relative mt-[50px] items-start justify-between pb-[80px]">
            {/* Left block */}
            <div class:list={["relative z-[2] flex flex-col gap-8", dark ? "text-white" : ""]}>
              {/* Customer card */}
              <div
                data-animate="fade-up"
                class:list={[
                  "relative w-[clamp(210px,calc(94.8px+11.6vw),262px)] rounded-[12px] border p-2",
                  dark ? "border-white/[0.3] bg-white/[0.08]" : "card-shell bg-white/80"
                ]}
              >
                <div
                  class:list={[
                    "relative rounded-[8px] border-2 px-[15px] py-6",
                    dark ? "border-[#b8b4b4]/60 [background:linear-gradient(137deg,rgba(255,255,255,0.1),rgba(0,0,0,0.8))]" : "border-border bg-white"
                  ]}
                >
                  <div class="mb-5 flex -space-x-3 xl:-space-x-6">
                    {sharedStats.avatars.map((avatar) => (
                      <Image src={avatar} alt="Customer avatar" class="h-[50px] w-[50px] xl:h-[80px] xl:w-[80px] rounded-full border-2 border-white object-cover" />
                    ))}
                  </div>
                  <p class:list={["text-[22px] font-medium", dark ? "text-white" : ""]}>We Have</p>
                  <p class="text-[22px] font-semibold text-secondary">{sharedStats.customers}</p>
                  <p class:list={["text-[22px] font-medium", dark ? "text-white" : ""]}>World-wide</p>
                  {dark && (
                    <Image
                      src={shape2}
                      alt=""
                      aria-hidden="true"
                      class="absolute top-[-25px] left-[calc(100%+15px)] w-[120px]"
                    />
                  )}
                </div>
              </div>
              {/* 90% satisfaction */}
              <div class="relative" data-animate="fade-up" style="--delay: 0.15s">
                <div class="flex items-center gap-4">
                  <span class="flex h-[50px] w-[50px] xl:h-[70px] xl:w-[70px] shrink-0 items-center justify-center rounded-full bg-lime text-heading">
                    <svg width="30" height="31" viewBox="0 0 30 31" fill="none">
                      <path d="M7.632 22.868L22.368 8.132" stroke="currentColor" stroke-width="2.456" stroke-linecap="round" stroke-linejoin="round" />
                      <path d="M10.395 8.132H22.368V20.105" stroke="currentColor" stroke-width="2.456" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                  <span class:list={["text-[50px] font-semibold leading-none xl:text-[65px]", dark ? "text-white" : ""]}>{sharedStats.satisfaction}</span>
                </div>
                <p class:list={["mt-2 text-[20px] xl:text-[24px]", dark ? "text-white" : ""]}>Satisfied Services</p>
                {dark && (
                  <Image
                    src={shape1}
                    alt=""
                    aria-hidden="true"
                    class="absolute top-1/2 left-[calc(100%+5px)] w-[80px] -translate-y-1/2"
                  />
                )}
              </div>
            </div>

            {/* Right block */}
            <div data-animate="fade-up" style="--delay: 0.2s" class:list={["relative z-[2] mt-[-75px] xl:mt-[-120px] flex flex-col items-center gap-[40px] xl:gap-[63px]", dark ? "text-white" : ""]}>
              {/* Promote Your Product */}
              <div class="w-[230px] xl:w-[280px]">
                <div class="mb-1 flex items-center gap-[15px] xl:gap-[24px]">
                  <button
                    id="hero-video-btn"
                    aria-label="Play video"
                    class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-lime text-heading transition-transform hover:scale-110"
                  >
                    <svg width="17" height="22" viewBox="0 0 17 22" fill="none">
                      <path d="M15.965 9.728c.94.588.94 1.956 0 2.544L2.295 20.816C1.296 21.44 0 20.722 0 19.544V2.456C0 1.278 1.296.56 2.295 1.184l13.67 8.544Z" fill="currentColor" />
                    </svg>
                  </button>
                  <h2 class:list={["text-[24px] font-semibold", dark ? "text-white" : ""]}>Promote Your Product</h2>
                </div>
                <div class="xl:pl-[72px]">
                  <p class:list={["mt-[6px] mb-6 text-[20px] leading-[1.6]", dark ? "text-white/75" : "text-body"]}>{description}</p>
                  <Button href="/contact/" label="Let's Talk" />
                </div>
              </div>

              {/* Circle stat */}
              <div
                class:list={[
                  "h-[200px] w-[200px] xl:h-[260px] xl:w-[260px] rounded-full border p-2.5 text-center",
                  dark ? "border-white/[0.3] bg-white/[0.08]" : "border-border bg-white/70"
                ]}
              >
                <div
                  class:list={[
                    "flex h-full w-full flex-col items-center justify-center rounded-full border",
                    dark ? "border-[#b8b4b4]/60 [background:linear-gradient(146deg,rgba(255,255,255,0.5),rgba(0,0,0,0.85))]" : "bg-white/80"
                  ]}
                >
                  <span class="text-[48px] xl:text-[56px] font-medium leading-none">{sharedStats.influencers}</span>
                  <span class:list={["mt-2 text-[20px] xl:text-[26px] leading-[1.3]", dark ? "text-white" : ""]}>Popular Influencer</span>
                </div>
              </div>
            </div>

            {/* Person image — absolutely positioned at bottom center like webflow */}
            <Image
              src={image}
              alt="Influencer hero image"
              loading="eager"
              fetchpriority="high"
              data-animate="fade"
              style="--delay: 0.1s"
              class="absolute bottom-0 left-[53%] w-[clamp(480px,calc(103.5px+37.95vw),650px)] -translate-x-1/2"
            />
          </div>
        </>
      ) : (
        <>
          <div class={`grid gap-10 xl:grid-cols-[1.1fr_0.9fr] xl:items-start`}>
            <div class="xl:pt-14" data-animate="fade-up">
              <h1 class={`display-title max-w-[860px] ${dark ? "text-white" : ""}`}>
                {beforeHighlight}
                <span class="text-secondary">{highlight}</span>
                {afterHighlight}
              </h1>
            </div>
            <div class={`xl:pt-28 ${dark ? "text-white" : ""}`} data-animate="fade-up" style="--delay: 0.15s">
              <div class="mb-4 flex items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-lime text-heading">
                  <svg width="14" height="18" viewBox="0 0 17 22" fill="none">
                    <path d="M15.965 9.728c.94.588.94 1.956 0 2.544L2.295 20.816C1.296 21.44 0 20.722 0 19.544V2.456C0 1.278 1.296.56 2.295 1.184l13.67 8.544Z" fill="currentColor" />
                  </svg>
                </span>
                <h2 class:list={["shrink-0 text-[20px] font-semibold xl:whitespace-nowrap", dark ? "text-white" : ""]}>Promote Your Product</h2>
              </div>
              <p class:list={["max-w-[260px] text-[16px] leading-[1.65]", dark ? "text-white/70" : "text-body"]}>{description}</p>
              <div class="mt-6">
                <Button href="/contact/" label="Let's Talk" />
              </div>
            </div>
          </div>

          <div class="relative mt-8 grid gap-10 xl:-mt-8 xl:grid-cols-[0.22fr_1fr_0.24fr] xl:items-end">
            <div class={`order-2 flex flex-col gap-10 xl:order-1 xl:pb-24 ${dark ? "text-white" : ""}`}>
              <div data-animate="fade-up" class={`card-shell w-full max-w-[208px] p-4 ${dark ? "border-white/30 bg-white/10 backdrop-blur-sm" : "bg-white/80"}`}>
                <div class="mb-5 flex -space-x-3">
                  {sharedStats.avatars.map((avatar) => (
                    <Image src={avatar} alt="Customer avatar" class="h-14 w-14 rounded-full border-2 border-white object-cover" />
                  ))}
                </div>
                <p class="text-[22px] font-medium">We Have</p>
                <p class="text-[22px] font-semibold text-secondary">{sharedStats.customers}</p>
                <p class="text-[22px] font-medium">World-wide</p>
              </div>
              <div>
                <div class="flex items-center gap-4">
                  <span class="flex h-12 w-12 items-center justify-center rounded-full bg-lime text-heading">↗</span>
                  <span class="text-[64px] font-semibold leading-none">{sharedStats.satisfaction}</span>
                </div>
                <p class="mt-2 text-[24px]">Satisfied Services</p>
              </div>
            </div>

            <div class="order-1 xl:order-2" data-animate="fade-up" style="--delay: 0.1s">
              <Image src={image} alt="Influencer hero image" loading="eager" fetchpriority="high" class="mx-auto h-auto w-full max-w-[680px]" />
            </div>

            <div class={`order-3 xl:pb-32 ${dark ? "text-white" : ""}`} data-animate="fade-up" style="--delay: 0.2s">
              <div
                class={`mx-auto flex h-[170px] w-[170px] flex-col items-center justify-center rounded-full border text-center ${dark ? "border-white/30 bg-white/10 backdrop-blur-sm" : "border-border bg-white/70"}`}
              >
                <span class="text-[40px] font-medium leading-none md:text-[62px]">{sharedStats.influencers}</span>
                <span class="mt-2 text-[18px] leading-[1.3] md:text-[22px]">Popular Influencer</span>
              </div>
            </div>
          </div>
        </>
      )
    }
  </div>
</section>

<!-- Video modal -->
<div
  id="hero-video-modal"
  class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/80 opacity-0 invisible transition-all duration-300"
  aria-modal="true"
  role="dialog"
>
  <div class="relative w-full max-w-[900px] px-4">
    <button
      id="hero-video-close"
      aria-label="Close video"
      class="absolute -top-10 right-4 flex h-9 w-9 items-center justify-center rounded-full bg-white/20 text-white transition hover:bg-white/40"
    >
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
    <div class="relative aspect-video w-full overflow-hidden rounded-xl">
      <div id="hero-video-container" class="absolute inset-0 h-full w-full"></div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ videoId, videoStart }}>
  const btn = document.getElementById("hero-video-btn");
  const btnMobile = document.getElementById("hero-video-btn-mobile");
  const btnTablet = document.getElementById("hero-video-btn-tablet");
  const modal = document.getElementById("hero-video-modal");
  const closeBtn = document.getElementById("hero-video-close");
  const container = document.getElementById("hero-video-container");
  const VIDEO_SRC = `https://www.youtube.com/embed/${videoId}?autoplay=1${videoStart ? `&start=${videoStart}` : ""}`;

  function openModal() {
    // Inject iframe only when user requests playback (facade pattern)
    const iframe = document.createElement("iframe");
    iframe.src = VIDEO_SRC;
    iframe.title = "Influvo video";
    iframe.allow = "autoplay; fullscreen; encrypted-media; picture-in-picture";
    iframe.allowFullscreen = true;
    iframe.className = "absolute inset-0 h-full w-full border-0";
    container.appendChild(iframe);

    modal.classList.remove("opacity-0", "invisible");
    modal.classList.add("opacity-100", "visible");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    // Destroy iframe to stop video and free network resources
    container.innerHTML = "";
    modal.classList.add("opacity-0", "invisible");
    modal.classList.remove("opacity-100", "visible");
    document.body.style.overflow = "";
  }

  btn?.addEventListener("click", openModal);
  btnMobile?.addEventListener("click", openModal);
  btnTablet?.addEventListener("click", openModal);
  closeBtn?.addEventListener("click", closeModal);
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModal();
  });
</script>

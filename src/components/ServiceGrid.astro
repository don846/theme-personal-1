---
export interface Props {
  title: string;
  items: Array<{ slug: string; title: string; excerpt: string; icon: string }>;
}

const { title, items } = Astro.props;
---

<section class="bg-white">
  <div class="container section-space">
    <div class="mb-14 text-center">
      <h2 class="section-title mx-auto max-w-[980px]" data-animate="fade-up">{title}</h2>
    </div>
    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {items.map((item, i) => (
        <article class="flex flex-col rounded-2xl border border-border bg-white p-8" data-animate="fade-up" style={`--delay: ${0.1 + i * 0.08}s`}>
          <div class="mb-6 text-heading">
            <Fragment set:html={item.icon} />
          </div>
          <h3 class="text-[26px] font-semibold leading-[1.2]">{item.title}</h3>
          <p class="mt-4 flex-1 text-[18px] leading-[1.6] text-body">{item.excerpt}</p>
          <div class="mt-8">
            <a
              href={`/services/${item.slug}/`}
              class="inline-flex items-center gap-3 text-[17px] font-medium text-heading hover:text-primary transition-colors"
            >
              Read Details
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary text-white">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

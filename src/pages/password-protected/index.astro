---
import AuthLayout from "@/layouts/AuthLayout.astro";
import logo from "@/assets/images/Frame-2147223321.png";
import { Image } from "astro:assets";
---

<AuthLayout title="Password Protected | Influvo" description="This content is password protected. Enter the password to continue.">
  <div class="flex h-screen flex-col">

    {/* Top section — surface bg with logo + title */}
    <div class="flex flex-col items-center justify-center border-b border-border bg-surface px-6" style="height: 65vh">
      <a href="/" class="mb-8 block w-[185px]">
        <Image src={logo} alt="Influvo" class="h-auto w-full" />
      </a>
      <h1 class="text-[32px] font-semibold text-heading">This Content is Protected.</h1>
      <p class="mt-2 text-[18px] text-body">Please enter your details</p>
    </div>

    {/* Bottom section — white, provides space below card */}
    <div class="flex flex-1 items-start justify-center bg-white px-6">

      {/* Card — overlaps the dividing line via -translate-y-1/2 */}
      <div class="relative w-full max-w-[450px] -translate-y-1/2 border border-border bg-white p-[25px]">
        <p class="text-[20px] font-medium text-heading">Enter Your Password :</p>
        <input
          type="password"
          name="pass"
          autofocus
          class="mb-10 mt-4 h-[48px] w-full border-b border-[#dadada] bg-transparent text-[16px] text-heading outline-none focus:border-primary"
        />
        <p id="pass-error" class="mb-3 hidden text-[14px] text-red-500">Incorrect password. Try <strong>demo</strong>.</p>
        <button
          id="pass-submit"
          type="button"
          class="flex h-[52px] w-full items-center justify-center gap-3 bg-primary text-[18px] font-medium text-white transition-colors duration-300 hover:bg-heading"
        >
          Submit Now
          <svg width="20" height="20" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7.8545 15H22.1455" stroke="currentColor" stroke-width="1.68" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M16.3398 9.19427L22.1456 15L16.3398 20.8057" stroke="currentColor" stroke-width="1.68" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

    </div>

  </div>
</AuthLayout>
<script>
  const DEMO_PASSWORD = "demo";
  const input = document.querySelector<HTMLInputElement>('input[name="pass"]')!;
  const btn = document.getElementById("pass-submit")!;
  const error = document.getElementById("pass-error")!;

  function handleSubmit() {
    if (input.value === DEMO_PASSWORD) {
      window.location.href = "/";
    } else {
      error.classList.remove("hidden");
      input.value = "";
      input.focus();
    }
  }

  btn.addEventListener("click", handleSubmit);
  input.addEventListener("keydown", (e) => {
    if (e.key === "Enter") handleSubmit();
  });
</script>

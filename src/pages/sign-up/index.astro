---
import AuthLayout from "@/layouts/AuthLayout.astro";
import AuthPanel from "@/components/AuthPanel.astro";
import { authPages } from "@/data/content";
---

<AuthLayout title="Sign Up | Influvo Astro Theme">
  <AuthPanel
    title={authPages.signUp.title}
    subtitle={authPages.signUp.subtitle}
    image={authPages.signUp.image}
    imageAlt={authPages.signUp.imageAlt}
  >
    <form class="w-full" method="get">
      <div class="flex flex-col gap-6 mb-4">

        <div>
          <label for="username" class="mb-2 block text-[20px] font-medium leading-[1.3] text-heading">
            Username or Email Address :
          </label>
          <input
            id="username"
            name="username"
            type="text"
            placeholder="Type username"
            required
            class="h-[52px] w-full rounded-md border border-[#dfe1e7] bg-white px-4 text-[17px] text-heading outline-none focus:border-primary"
          />
        </div>

        <div>
          <label for="password" class="mb-2 block text-[20px] font-medium leading-[1.3] text-heading">
            Password :
          </label>
          <input
            id="password"
            name="password"
            type="password"
            placeholder="Type password :"
            required
            class="h-[52px] w-full rounded-md border border-[#dfe1e7] bg-white px-4 text-[17px] text-heading outline-none focus:border-primary"
          />
        </div>

        <div>
          <label for="retype-password" class="mb-2 block text-[20px] font-medium leading-[1.3] text-heading">
            Re-type Password :
          </label>
          <input
            id="retype-password"
            name="retype-password"
            type="password"
            placeholder="Type password :"
            required
            class="h-[52px] w-full rounded-md border border-[#dfe1e7] bg-white px-4 text-[17px] text-heading outline-none focus:border-primary"
          />
        </div>

      </div>

      {/* Submit button */}
      <button
        type="submit"
        class="flex h-[52px] w-full items-center justify-center gap-3 bg-primary text-[18px] font-medium text-white transition-colors duration-300 hover:bg-heading"
      >
        Sign up now
        <svg width="20" height="20" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M7.8545 15H22.1455" stroke="currentColor" stroke-width="1.68" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M16.3398 9.19427L22.1456 15L16.3398 20.8057" stroke="currentColor" stroke-width="1.68" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      {/* Remember me */}
      <div class="mt-6 flex items-center gap-2">
        <input
          id="remember"
          name="remember"
          type="checkbox"
          class="h-5 w-5 accent-primary"
        />
        <label for="remember" class="text-[17px] text-heading">Remember Me</label>
      </div>

      {/* Bottom link */}
      <div class="mt-8 flex items-center justify-center gap-4 text-[17px]">
        <span class="text-heading">Already have an account?</span>
        <a href="/sign-in/" class="font-semibold text-primary transition-colors hover:text-heading">Log In</a>
      </div>
    </form>
  </AuthPanel>
</AuthLayout>
